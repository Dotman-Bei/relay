# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
RELAY_NETWORK=testnet
RELAY_TAG=local

# Public hostnames (DNS A/AAAA records must point at this server before `docker compose up`).
RELAY_DOMAIN=relay.example.com
STORAGE_DOMAIN=storage.relay.example.com
STEWARD_DOMAIN=steward.relay.example.com
ACME_EMAIL=you@example.com

# Optional: Memory Steward model prompts (claude-opus-5). Empty = labelled TEMPLATE prompts.
ANTHROPIC_API_KEY=
