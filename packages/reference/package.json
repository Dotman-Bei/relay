{
  "name": "@relay/reference",
  "version": "0.1.0",
  "description": "Deterministic reference implementation of Relay protocol v1 lifecycle rules. Mirrors CapsuleRegistry decision-for-decision.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": { ".": "./src/index.ts" },
  "publishConfig": { "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } } },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": { "@relay/protocol-types": "workspace:*", "viem": "^2.56.8" },
  "devDependencies": { "fast-check": "^4.10.2", "tsup": "^8.5.1", "typescript": "5.9.3", "vitest": "^5.0.1" }
}
