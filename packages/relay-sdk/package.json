{
  "name": "@relay/sdk",
  "version": "0.1.0",
  "description": "Relay SDK: local encryption, threshold key shares, content-addressed storage, typed CapsuleRegistry reads, write preparation and event decoding. Reads chain state without Relay's backend.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": { ".": "./src/index.ts" },
  "publishConfig": { "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } } },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@relay/protocol-types": "workspace:*",
    "@relay/reference": "workspace:*",
    "viem": "^2.56.8",
    "zod": "^4.6.5"
  },
  "devDependencies": { "fast-check": "^4.10.2", "tsup": "^8.5.1", "typescript": "5.9.3", "vitest": "^5.0.1" }
}
